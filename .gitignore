# Android factory images / proprietary artifacts

# AOSP SYNC
# This goes into aosp/androidversion/ so you can use your own git within it
/aosp/
.treeforge-reference/

# Real factory-image fixtures
tests/fixtures/factory/*
!tests/fixtures/factory/.gitkeep

# Factory-image / OTA archives
*-factory-*.zip
*-ota-*.zip

# Android partition / boot images
*.img

# Intentional repository boot test fixtures
!tests/fixtures/boot/boot.img
!tests/fixtures/boot/vendor_boot.img

# OTA / dynamic-partition payloads
payload.bin

# Extracted Android filesystem trees
/extracted/
/extracted-*/


# Temporary TreeForge migration tooling

/tools/


